<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DualWeatherTemp" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="WidgetHour">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Red strip shown while an important NWS alert is active. -->
    <style name="WidgetAlert">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/widget_alert_background</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">2dp</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetRefresh">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:padding">8dp</item>
        <item name="android:src">@drawable/ic_refresh</item>
    </style>
</resources>
